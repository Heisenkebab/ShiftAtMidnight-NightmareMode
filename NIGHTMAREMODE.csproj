<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <AssemblyName>NIGHTMAREMODE</AssemblyName>
    <Product>NIGHTMARE Mode</Product>
    <Version>1.0.1</Version>
    <BepInExPluginGuid>nightmaremode</BepInExPluginGuid>
    <BepInExPluginName>NIGHTMARE Mode</BepInExPluginName>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <LangVersion>latest</LangVersion>
    <RestoreAdditionalProjectSources>
      https://api.nuget.org/v3/index.json;
      https://nuget.bepinex.dev/v3/index.json;
      https://nuget.samboy.dev/v3/index.json
    </RestoreAdditionalProjectSources>
    <RootNamespace>NIGHTMAREMODE</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BepInEx.Unity.IL2CPP" Version="6.0.0-be.*" IncludeAssets="compile" />
    <PackageReference Include="BepInEx.PluginInfoProps" Version="2.*" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="Assembly-CSharp">
      <HintPath>./lib/Assembly-CSharp.dll</HintPath>
    </Reference>

    <Reference Include="Fusion.Runtime">
      <HintPath>./lib/Fusion.Runtime.dll</HintPath>
    </Reference>

    <Reference Include="UnityEngine.CoreModule">
      <HintPath>./lib/UnityEngine.CoreModule.dll</HintPath>
    </Reference>

    <Reference Include="Il2Cppmscorlib">
      <HintPath>./lib/Il2Cppmscorlib.dll</HintPath>
    </Reference>

    <Reference Include="ModSettingsMenu">
      <HintPath>./lib/ModSettingsMenu.dll</HintPath>
    </Reference>

    <Reference Include="UnityEngine.UI">
      <HintPath>./lib/UnityEngine.UI.dll</HintPath>
    </Reference>

    <Reference Include="UnityEngine.PhysicsModule">
      <HintPath>./lib/UnityEngine.PhysicsModule.dll</HintPath>
    </Reference>

    <Reference Include="Unity.TextMeshPro">
      <HintPath>./lib/Unity.TextMeshPro.dll</HintPath>
    </Reference>

    <Reference Include="UnityEngine.AnimationModule">
      <HintPath>./lib/UnityEngine.AnimationModule.dll</HintPath>
    </Reference>

  </ItemGroup>

  <PropertyGroup>
    <!-- Point this at your actual game install. If it is empty or does not exist,
         DeployToGame is skipped, so a fresh clone still builds cleanly. -->
    <GameDir>C:\Users\hk\AppData\Roaming\Thunderstore Mod Manager\DataFolder\ShiftAtMidnight\profiles\Default</GameDir>
  </PropertyGroup>

  <Target Name="DeployToGame" AfterTargets="Build"
    Condition="'$(GameDir)' != '' AND Exists('$(GameDir)')">
    <ItemGroup>
      <DeployFiles Include="$(OutputPath)$(AssemblyName).dll" />
    </ItemGroup>
    <Copy SourceFiles="@(DeployFiles)"
      DestinationFolder="$(GameDir)\BepInEx\plugins\NIGHTMAREMODE\"
      SkipUnchangedFiles="false" />
  </Target>

  <!-- Thunderstore packaging. Deliberately NOT hooked to Build: run it explicitly
       with `dotnet build -c Release -t:ThunderstorePackage` when cutting a release. -->
  <PropertyGroup>
    <ThunderstoreDir>$(MSBuildProjectDirectory)\thunderstore</ThunderstoreDir>
    <PackageStageDir>$(MSBuildProjectDirectory)\artifacts\package</PackageStageDir>
    <PackageZipPath>$(MSBuildProjectDirectory)\artifacts\$(AssemblyName)-$(Version).zip</PackageZipPath>
  </PropertyGroup>

  <Target Name="ThunderstorePackage" DependsOnTargets="Build">

    <Error Condition="!Exists('$(ThunderstoreDir)\icon.png')"
      Text="Missing $(ThunderstoreDir)\icon.png - Thunderstore requires a 256x256 PNG icon at the package root." />
    <Error Condition="!Exists('$(ThunderstoreDir)\manifest.json.in')"
      Text="Missing $(ThunderstoreDir)\manifest.json.in - the manifest template." />

    <!-- Wipe staging so stale files from a previous version can never ship. -->
    <RemoveDir Directories="$(PackageStageDir)" />
    <MakeDir Directories="$(PackageStageDir)\$(AssemblyName)" />

    <!-- The three required root files. README.MD is renamed to README.md;
         Thunderstore filenames are case-sensitive. -->
    <Copy SourceFiles="$(ThunderstoreDir)\icon.png"
      DestinationFiles="$(PackageStageDir)\icon.png" />
    <Copy SourceFiles="$(MSBuildProjectDirectory)\README.MD"
      DestinationFiles="$(PackageStageDir)\README.md" />

    <PropertyGroup>
      <_ManifestText>$([System.IO.File]::ReadAllText('$(ThunderstoreDir)\manifest.json.in'))</_ManifestText>
      <_ManifestText>$(_ManifestText.Replace('{VERSION}', '$(Version)'))</_ManifestText>
      <_ManifestText>$(_ManifestText.Replace(';', '%3B'))</_ManifestText>
    </PropertyGroup>
    <WriteLinesToFile File="$(PackageStageDir)\manifest.json"
      Lines="$(_ManifestText)"
      Overwrite="true"
      Encoding="us-ascii"
      WriteOnlyWhenDifferent="false" />

    <Copy SourceFiles="$(OutputPath)$(AssemblyName).dll"
      DestinationFolder="$(PackageStageDir)\$(AssemblyName)" />

    <!-- Zips the *contents* of the staging dir, so the required files land at the
         zip root rather than inside a folder. -->
    <ZipDirectory SourceDirectory="$(PackageStageDir)"
      DestinationFile="$(PackageZipPath)"
      Overwrite="true" />

    <Message Importance="high" Text="Thunderstore package: $(PackageZipPath)" />
  </Target>
</Project>
